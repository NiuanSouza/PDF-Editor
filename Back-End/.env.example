# Copie este arquivo para .env e preencha os valores

# Obrigatório em produção — gere uma chave segura:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-troque-isso-em-producao

# True para desenvolvimento local, False em produção
DEBUG=True

# Hosts permitidos (separados por vírgula)
# Em produção: seu-app.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — URL do FrontEnd que pode chamar a API
# Em produção: https://pdf-editor-frontend.onrender.com
# Deixe CORS_ALLOW_ALL_ORIGINS=True para desenvolvimento
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://pdf-editor-frontend.onrender.com

# Banco de dados — SQLite por padrão (não precisa definir)
# Para PostgreSQL: postgres://user:password@host:5432/dbname
# DATABASE_URL=sqlite:///db.sqlite3

# Módulo de settings
DJANGO_SETTINGS_MODULE=config.settings.base
